{
  "name": "@truocloud/openapi",
  "version": "0.1.0",
  "description": "OpenAPI specification of the TruoCloud public API (api.truo.cloud/v1)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1.json": "./openapi/v1.json"
  },
  "//files": "The raw spec is published alongside the bundle: some tools want the JSON, not a module.",
  "files": ["dist", "openapi", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truocloud/truo-devkit.git",
    "directory": "packages/openapi"
  },
  "keywords": ["truocloud", "openapi", "api"],
  "sideEffects": false
}
