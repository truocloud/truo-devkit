{
  "name": "@truocloud/sdk",
  "version": "0.1.0",
  "description": "Cliente TypeScript de la API publica de TruoCloud (api.truo.cloud). Sin dependencias.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "//files": "Se publica lo construido, no los fuentes: importan con extension .ts y Node no los carga.",
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truocloud/truo-devkit.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.truo.cloud",
  "bugs": {
    "url": "https://github.com/truocloud/truo-devkit/issues"
  },
  "keywords": ["truocloud", "vps", "dns", "dbaas", "api", "sdk"],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "dependencies": {},
  "scripts": {
    "build": "bunx tsc --project tsconfig.build.json && bun build src/index.ts --outdir dist --target node --format esm",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
