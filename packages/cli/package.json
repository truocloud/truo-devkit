{
  "name": "@truocloud/cli",
  "version": "0.1.0",
  "description": "TruoCloud CLI: operate VPS, DNS, databases, containers and load balancers from the terminal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "truo": "./dist/truo.js"
  },
  "main": "./dist/truo.js",
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truocloud/truo-devkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.truo.cloud/cli",
  "bugs": {
    "url": "https://github.com/truocloud/truo-devkit/issues"
  },
  "keywords": ["truocloud", "cli", "vps", "dns", "devops"],
  "engines": {
    "node": ">=20"
  },
  "//deps": "Zero dependencies: the CLI is published bundled (the SDK travels inside), so `npm i -g` drags nothing along and the compiled binary is a single file.",
  "dependencies": {},
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "build:binaries": "bun scripts/build.ts --binaries",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
