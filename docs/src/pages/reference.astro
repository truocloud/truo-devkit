---
/**
 * Referencia interactiva (Scalar) sobre el mismo `openapi.json` que sirve la API.
 *
 * Fuera de Starlight a proposito: Scalar trae su propio layout de tres columnas y
 * su playground, y meterlo dentro del layout de la documentacion produce dos
 * sidebars peleandose por el ancho.
 *
 * Se carga el bundle standalone por CDN en vez de importar el paquete: es el
 * camino que Scalar documenta como estable para cualquier HTML, y evita atar el
 * build de la documentacion a una incompatibilidad entre la version de Scalar y
 * la de Vite. `openapi.json` lo copia `scripts/generate.ts` a `public/`.
 */
const title = "Referencia de la API · TruoCloud";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Referencia interactiva de la API publica de TruoCloud: probá cada endpoint contra tu cuenta."
    />
    <link rel="canonical" href="https://docs.truo.cloud/reference/" />
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
      }
      /* Barra propia: sin ella no hay forma de volver a la documentacion. */
      .volver {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 100;
        padding: 6px 12px;
        border-radius: 999px;
        background: #0f1410;
        color: #ccd5cf;
        border: 1px solid #27352b;
        font: 500 13px/1 system-ui, sans-serif;
        text-decoration: none;
      }
      .volver:hover {
        color: #fff;
        border-color: #3b4e42;
      }
    </style>
  </head>
  <body>
    <a class="volver" href="/">← Documentación</a>
    <div id="app"></div>

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1/dist/browser/standalone.js"
    ></script>
    <script is:inline>
      // `createApiReference` lo expone el bundle standalone en `window.Scalar`.
      window.Scalar.createApiReference("#app", {
        url: "/openapi.json",
        theme: "purple",
        darkMode: true,
        hideDownloadButton: false,
        metaData: { title: "API de TruoCloud" },
        // El servidor de produccion ya viene en el spec; declararlo de nuevo aca
        // seria un segundo lugar donde puede quedar viejo.
        authentication: {
          preferredSecurityScheme: "bearerAuth",
        },
      });
    </script>
  </body>
</html>
